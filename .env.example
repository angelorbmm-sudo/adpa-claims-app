# Frontend
VITE_API_BASE_URL=http://localhost:8787

# Server
PORT=8787
NODE_ENV=development
DATABASE_URL=postgres://user:password@localhost:5432/adpa
DATABASE_SSL=false

# Authentication - required in production
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
AUTH_DEV_BYPASS=false
AUTH_DEV_USER_ID=
AUTH_DEV_USER_EMAIL=

# CORS
APP_ORIGIN=http://localhost:5173

# File storage
STORAGE_PROVIDER=disabled
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=

# Never commit real secrets. Use your deployment provider's secret manager.

# Inspection AI (server only; explicit model with vision + structured output support)
OPENAI_API_KEY=
INSPECTION_AI_MODEL=
